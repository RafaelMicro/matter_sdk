{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    
    "configurations": [
        {
            "name": "Attach to running process",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}"
        },
        {
            "name": "(WSL) Attach OpenOCD (rt58x)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "external",
            "gdbTarget": "127.0.0.1:50000",
            "gdbPath": "${workspaceFolder}/toolchain/arm/Linux/bin/arm-none-eabi-gdb",
            "executable": "${workspaceFolder}/out/${input:exampleproject}/${input:board}/${input:board}-${input:exampleproject}-example.out",
            "showDevDebugOutput": "raw",
            "console": "integratedTerminal",
            "postAttachCommands": [
                "set substitute-path /var/chip ${workspaceFolder}",
                "set breakpoint pending on",
                "monitor reset halt",
                "tbreak main",
                "continue"
            ]
        }
    ],
    "inputs": [
        {
            "type": "pickString",
            "id": "board",
            "description": "Rafael board type",
            "options": ["RT583", "RT584H", "RT584L", "RT584HA4"],
            "default": "RT583"
        },
        {
            "type": "pickString",
            "id": "exampleproject",
            "description": "Which example do you want to create?",
            "options": [
                "contact-sensor-app",
                "humidity-sensor-app",
                "light-switch-app",
                "lighting-app",
                "lock-app",
                "occupancy-sensor-app",
                "smart-plug-app",
                "smoke-alarm-app",
                "temperature-measurement-app",
                "thermostat",
                "water-valve-app",
                "window-app"
            ],
            "default": ""
        },
    ]
}
